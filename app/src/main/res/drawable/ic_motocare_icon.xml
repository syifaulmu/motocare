<?xml version="1.0" encoding="utf-8"?>
<!--
  Retro Speedometer Icon for MotoCare v2.0
  Primary color: #FF6B00 (Orange Amber)
  viewportWidth=100, viewportHeight=100
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="100"
    android:viewportHeight="100">

    <!-- Background circle (dark) -->
    <path
        android:fillColor="#0D0D0D"
        android:pathData="M50,50 m-48,0 a48,48 0 1,0 96,0 a48,48 0 1,0 -96,0"/>

    <!-- Outer gauge ring (orange amber thick border) -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#FF6B00"
        android:strokeWidth="4"
        android:pathData="M50,50 m-44,0 a44,44 0 1,0 88,0 a44,44 0 1,0 -88,0"/>

    <!-- Inner speedometer face (semi-arc, bottom half open) -->
    <!-- Arc from 210° to 330° (bottom cutout), i.e., top 240° of circle -->
    <!-- Using SVG arc: start at 210deg, sweep 240deg to 330deg counterclockwise means top arc -->
    <!-- Start point at 210°: x=50+36*cos(210°)=50-31.18=18.82, y=50+36*sin(210°)=50-18=32 -->
    <!-- Actually drawing a stroke arc from ~225° to ~315° open bottom -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#FF6B00"
        android:strokeWidth="2.5"
        android:pathData="M19.4,69.4 A36,36 0 1,1 80.6,69.4"/>

    <!-- Tick marks on speedometer (small lines around arc) -->
    <!-- Major ticks -->
    <path
        android:strokeColor="#FFD700"
        android:strokeWidth="2"
        android:pathData="M50,14 L50,20"/>
    <path
        android:strokeColor="#FFD700"
        android:strokeWidth="2"
        android:pathData="M23.9,21.9 L27.9,26.8"/>
    <path
        android:strokeColor="#FFD700"
        android:strokeWidth="2"
        android:pathData="M76.1,21.9 L72.1,26.8"/>
    <path
        android:strokeColor="#F5F0E8"
        android:strokeWidth="1.5"
        android:pathData="M14,50 L19.5,50"/>
    <path
        android:strokeColor="#F5F0E8"
        android:strokeWidth="1.5"
        android:pathData="M86,50 L80.5,50"/>

    <!-- Needle (pointer) pointing at ~11 o'clock position, orange -->
    <!-- Pivot at center (50,50), pointing toward upper-right at ~300° from positive x -->
    <!-- Line from center to outer ring toward ~330° -->
    <path
        android:strokeColor="#FF6B00"
        android:strokeLineCap="round"
        android:strokeWidth="2.5"
        android:pathData="M50,50 L68,26"/>

    <!-- Needle base cap circle (center dot) -->
    <path
        android:fillColor="#FF6B00"
        android:pathData="M50,50 m-5,0 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0"/>

    <!-- Inner dot (center highlight) -->
    <path
        android:fillColor="#FFD700"
        android:pathData="M50,50 m-2,0 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0"/>

    <!-- Bottom label "M" indicator -->
    <path
        android:fillColor="#F5F0E8"
        android:pathData="M43,76 L43,84 L45.5,84 L45.5,79.5 L50,84 L54.5,79.5 L54.5,84 L57,84 L57,76 L54.5,76 L50,80.5 L45.5,76 Z"/>

</vector>
