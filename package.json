{
  "name": "motocare",
  "version": "2.0.0",
  "description": "MotoCare v2.0 - Aplikasi Perawatan & Monitoring Motor Roda Dua Indonesia",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "node scripts/build_bundle.js && prettier --write \"assets/app*.js\" \"app/src/main/assets/app.js\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint assets tests",
    "lint:fix": "eslint assets tests --fix",
    "format": "prettier --write \"assets/**/*.js\" \"tests/**/*.js\"",
    "format:check": "prettier --check \"assets/**/*.js\" \"tests/**/*.js\""
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.0.7",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.2",
    "prettier": "^3.5.2",
    "vitest": "^3.0.7"
  }
}
